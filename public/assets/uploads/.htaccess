Options -Indexes -ExecCGI

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|rb|sh|bash|exe|com|bat|cmd|jar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .rb .sh
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
