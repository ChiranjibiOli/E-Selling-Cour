{
  "version": 2,
  "repository_strategy": "monorepo",
  "branch_strategy": "main-only",
  "architecture": "house-compound-with-domain-microservices",
  "frontend": {
    "application": "apps/web-platform",
    "entrance": "apps/web-platform/public/index.php",
    "floors": {
      "public": {"path": "apps/web-platform/src/Public", "route_prefix": "/"},
      "student": {"path": "apps/web-platform/src/Student", "route_prefix": "/student"},
      "instructor": {"path": "apps/web-platform/src/Instructor", "route_prefix": "/instructor"},
      "admin": {"path": "apps/web-platform/src/Admin", "route_prefix": "/admin"}
    }
  },
  "backend_services": [
    "api-gateway",
    "identity-service",
    "catalog-service",
    "learning-service",
    "commerce-service",
    "payment-service",
    "enrollment-service",
    "media-service",
    "notification-service",
    "review-service",
    "reporting-service"
  ],
  "migration": {
    "strategy": "room-by-room-strangler",
    "legacy_source": ["app", "public", "routes"],
    "rule": "A legacy feature is deleted only after its room and backend feature pass parity tests."
  }
}
