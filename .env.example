APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
WEB_PLATFORM_PORT=9001
API_GATEWAY_PORT=9000
API_BASE_URL=http://127.0.0.1:9000
APP_URL=http://localhost:9001
GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id.apps.googleusercontent.com
SESSION_COOKIE_SECURE=false
COURSEHUB_STORAGE_PATH=./storage
ALLOW_LOCAL_RESET_TOKEN=false
ALLOW_LOCAL_EMAIL_CODE=false

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-coursehub-gmail@gmail.com
SMTP_PASSWORD=replace-with-a-google-app-password
SMTP_FROM_ADDRESS=your-coursehub-gmail@gmail.com
SMTP_FROM_NAME=CourseHub

# Automatic Student checkout. Use sandbox merchant credentials while testing.
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace-with-esewa-merchant-secret
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=replace-with-khalti-live-secret-key
KHALTI_API_URL=https://dev.khalti.com/api/v2
KHALTI_WEBSITE_URL=http://localhost:9001

# Optional Instructor disbursement API. Keep false until your provider has
# approved and issued a real payout/disbursement endpoint and credentials.
AUTO_PAYOUT_ENABLED=false
PAYOUT_API_URL=https://payout-provider.example/api/v1/transfers
PAYOUT_API_TOKEN=replace-with-payout-api-token
PAYOUT_HMAC_SECRET=replace-with-a-separate-payout-signing-secret
PAYOUT_METHOD_PRIORITY=bank,esewa,khalti

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=coursehub
DB_USERNAME=root
DB_PASSWORD=
IDENTITY_SESSION_TTL=28800
ADMIN_LOGIN_PATH=/control-room/entry-9d4f
ADMIN_ACCESS_CODE=replace-with-a-long-random-admin-entry-code
ADMIN_ALLOWED_IPS=
IDENTITY_SERVICE_URL=http://127.0.0.1:9101
CATALOG_SERVICE_URL=http://127.0.0.1:9102
LEARNING_SERVICE_URL=http://127.0.0.1:9103
COMMERCE_SERVICE_URL=http://127.0.0.1:9104
PAYMENT_SERVICE_URL=http://127.0.0.1:9105
ENROLLMENT_SERVICE_URL=http://127.0.0.1:9106
MEDIA_SERVICE_URL=http://127.0.0.1:9107
NOTIFICATION_SERVICE_URL=http://127.0.0.1:9108
REVIEW_SERVICE_URL=http://127.0.0.1:9109
REPORTING_SERVICE_URL=http://127.0.0.1:9110
