APP_NAME=CourseHub
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kathmandu
APP_SESSION_NAME=coursehub_session

# Authenticated sessions expire after inactivity and have an absolute lifetime.
SESSION_IDLE_TIMEOUT=7200
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_REGENERATE_INTERVAL=900

# Local XAMPP normally uses 127.0.0.1 and this project uses port 3307.
# The older uploaded database dump is named course_selling.
# database/schema.sql creates the newer coursehub database.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=course_selling
DB_USERNAME=root
DB_PASSWORD=

# In local development only, try 3307/3306 and course_selling/coursehub when
# the configured target cannot be reached. Set false in production.
DB_ALLOW_LOCAL_FALLBACK=true
