APP_NAME=CourseHub
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kathmandu
APP_SESSION_NAME=coursehub_session

# Authenticated sessions expire after inactivity and have an absolute lifetime.
SESSION_IDLE_TIMEOUT=7200
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_REGENERATE_INTERVAL=900

# Local XAMPP uses 127.0.0.1 and MySQL/MariaDB port 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=coursehub
DB_USERNAME=root
DB_PASSWORD=

# In local development, retry localhost when 127.0.0.1 is unavailable.
# The database name remains coursehub and the port remains 3307.
DB_ALLOW_LOCAL_FALLBACK=true
